#kmean cluster
library(factoextra)
data(iris)
iris_hum <- iris[ ,1:4]
my_pca <- prcomp(iris_hum, scale= TRUE)
summary(my_pca)
my_pca_data <- data.frame(my_pca $ x[ ,1:2])  
head(my_pca_data)  

fviz_nbclust(my_pca_data, FUNcluster= kmeans, method= "wss")  

set.seed(123)
my_kmeans <- kmeans (my_pca_data, centers = 3)
fviz_pca_ind(my_pca, 
             habillage = my_kmeans$cluster,
             label= "none",
             addEllipses = TRUE)

#hierarchical clusters

library(factoextra)
iris.labels <- iris$Species
table(iris.labels)
iris_data= iris [1:4]
iris_data_std= scale(iris_data)
iris_dist= dist(iris_data_std)
hc.out_iris <- hclust(iris_dist, method = "complete")
plot(hc.out_iris)
rect.hclust(hc.out_iris, k=3, border= 2:5)
iris.clusters <- cutree(hc.out_iris, k=3)
row.names(iris_data_std) <- paste(iris$Species,
                                  1:dim(iris)[1],
                                  sep= " ")
fviz_cluster(list(data=iris_data_std, cluster= iris.clusters))
table(iris.clusters, iris$Species)

