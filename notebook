#ttest
library(tidyverse)
library(patchwork)
library(gapminder)

gapminder %>% 
  filter(continent== "Africa") %>% 
  select(lifeExp) %>% 
  t.test(mu = 50)

gapminder %>% 
  filter(continent %in% c ( "Africa", "Europe")) %>% 
  t.test(lifeExp~continent, data=., alternative= "two.sided")

gapminder %>% 
  filter(continent %in% c ( "Africa", "Europe")) %>% 
  t.test(lifeExp~continent, data=., alternative= "less",
         conf.level=0.95)
gapminder %>% 
  filter(year %in% c(1957,2007)& continent=="Africa") %>% 
  mutate(year= factor(year, levels = c(2007,1957))) %>% 
  t.test(lifeExp ~ year, data = . , pair= TRUE)

